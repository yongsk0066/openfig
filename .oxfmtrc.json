{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "tabWidth": 2,
  "useTabs": false,
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "build/**",
    "target/**",
    "crates/**",
    "tests/zsh-hook/**",
    "specs/src/**",
    "proto/src/**",
    "packages/fuzzysort/**",
    "pnpm-lock.yaml",
    "**/*.md",
    "resources/**"
  ]
}
