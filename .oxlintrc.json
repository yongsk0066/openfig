{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "react-hooks", "jsx-a11y", "import", "unicorn"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "args": "all",
        "argsIgnorePattern": "^_",
        "caughtErrors": "all",
        "caughtErrorsIgnorePattern": "^_",
        "destructuredArrayIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "unicorn/prefer-module": "error",
    "unicorn/no-abusive-eslint-disable": "error",
    "unicorn/no-useless-spread": "error",
    "unicorn/prefer-blob-reading-methods": "error",
    "unicorn/prefer-date-now": "error",
    "unicorn/prefer-includes": "warn",
    "unicorn/prefer-keyboard-event-key": "error",
    "unicorn/prefer-modern-dom-apis": "error",
    "unicorn/prefer-modern-math-apis": "error",
    "unicorn/prefer-native-coercion-functions": "error",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/prefer-object-from-entries": "error",
    "unicorn/prefer-reflect-apply": "error",
    "unicorn/prefer-string-trim-start-end": "error",
    "unicorn/prefer-type-error": "warn",
    "react/react-in-jsx-scope": "off",
    "react/set-state-in-effect": "warn",
    "react/refs": "warn",
    "jsx-a11y/alt-text": "warn",
    "jsx-a11y/anchor-has-content": "warn",
    "jsx-a11y/no-static-element-interactions": "warn",
    "jsx-a11y/click-events-have-key-events": "warn",
    "jsx-a11y/prefer-tag-over-role": "warn",
    "unicorn/no-useless-fallback-in-spread": "warn",
    "typescript/no-floating-promises": "warn",
    "typescript/no-misused-promises": "warn",
    "typescript/await-thenable": "warn",
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/no-unnecessary-type-assertion": "off",
    "typescript/no-unnecessary-type-parameters": "off",
    "typescript/no-unnecessary-type-arguments": "off",
    "typescript/no-unnecessary-type-conversion": "off",
    "typescript/no-unnecessary-template-expression": "off",
    "typescript/no-unnecessary-boolean-literal-compare": "off",
    "typescript/no-unsafe-enum-comparison": "off",
    "typescript/restrict-template-expressions": "off",
    "typescript/no-extraneous-class": "off",
    "typescript/consistent-return": "off",
    "typescript/unbound-method": "off",
    "typescript/no-useless-default-assignment": "off",
    "typescript/no-misused-spread": "off",
    "typescript/no-base-to-string": "off"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "build/**",
    "target/**",
    "**/*.config.js",
    "**/*.config.ts",
    "proto/src/**",
    "packages/fuzzysort/**"
  ],
  "overrides": [
    {
      "files": [
        "packages/autocomplete-parser/src/{core,parserCore,specLoader,specRepository}.ts",
        "packages/autocomplete-app/src/state/{generators,model,transitions,effects,generator-plan,pipeline,insertion,keypress,types,fig-state}.ts",
        "packages/autocomplete-app/src/{runtime,engine,subscription,parser/coordinator,parser/cacheScopes,generators/cache,generators/helpers,history/repository,suggestions/index,suggestions/sorting}.ts"
      ],
      "rules": {
        "no-restricted-globals": [
          "error",
          "window",
          "document",
          "localStorage",
          "globalThis",
          "global",
          "self",
          "performance",
          "Date",
          "setTimeout",
          "clearTimeout",
          "setInterval",
          "clearInterval",
          "requestAnimationFrame",
          "cancelAnimationFrame",
          "queueMicrotask",
          "setImmediate",
          "clearImmediate",
          "requestIdleCallback",
          "cancelIdleCallback",
          "process",
          "fetch",
          "crypto",
          "eval",
          "Function"
        ]
      }
    },
    {
      "files": ["packages/**/*.ts", "packages/**/*.tsx"],
      "rules": { "typescript/no-floating-promises": "error" }
    },
    {
      // Upstream completion specs. A generator callback's parameters are positional
      // (`(tokens, executeShellCommand, context)`), so a leading one cannot be dropped
      // when a later one is used; `after-used` still flags genuinely dead trailing params.
      "files": ["specs/src/**"],
      "rules": {
        "no-unused-vars": [
          "error",
          {
            "args": "after-used",
            "argsIgnorePattern": "^_",
            "caughtErrors": "all",
            "caughtErrorsIgnorePattern": "^_",
            "destructuredArrayIgnorePattern": "^_",
            "varsIgnorePattern": "^_",
            "ignoreRestSiblings": true
          }
        ]
      }
    },
    {
      "files": ["tests/fig-api/**", "packages/*/tests/**", "**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "no-eval": "off",
        "unicorn/prefer-module": "off",
        "no-import-assign": "off"
      }
    }
  ]
}
