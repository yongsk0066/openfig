# Single source of truth for every product name in this repo.
#
# Shell-sourceable KEY=VALUE. Read by:
#   - Justfile              via `set dotenv-filename := "branding.env"`
#   - crates/fig_util/build.rs which re-emits each key as FIG_BRAND_<KEY>
#
# Format: one KEY=VALUE per line, `#` comments, optional double quotes around
# the value. No expansion, no substitution.
#
# There is deliberately no PRODUCT_NAME key: the bundle directory name
# ("$APP_NAME.app"), CFBundleName/CFBundleDisplayName and the Rust constants
# PRODUCT_NAME and APP_BUNDLE_NAME all derive from APP_NAME, so they cannot
# drift apart.
APP_NAME="Amazon Q"
BUNDLE_ID=com.amazon.codewhisperer
DESKTOP_BIN=q_desktop
CLI_BIN=q
PTY_BIN=qterm
URL_SCHEME=q
DATA_DIR_NAME=amazon-q
RUNTIME_DIR_NAME=cwrun
BACKUP_DIR_NAME=.amazon-q.dotfiles.bak
