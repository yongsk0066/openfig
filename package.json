{
  "name": "root",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "author": "OpenFig contributors",
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "b": "turbo build",
    "format": "cargo +nightly fmt",
    "clippy": "cargo clippy --locked --workspace --color always -- -D warnings",
    "test": "vitest",
    "test:ci": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "dev": "turbo dev",
    "dev:autocomplete": "pnpm -C packages/autocomplete-app dev",
    "dev:dashboard": "pnpm -C packages/dashboard-app dev",
    "preview:autocomplete": "pnpm -C packages/autocomplete-app preview",
    "preview:dashboard": "pnpm -C packages/dashboard-app preview",
    "clean": "turbo clean --parallel",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint:proto": "pnpm --filter ./proto lint",
    "typecheck": "turbo typecheck",
    "codegen": "turbo codegen"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "jsdom": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.3.4"
}
