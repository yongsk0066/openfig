{
  "name": "@fig/api-bindings",
  "version": "0.2.0",
  "license": "MIT OR Apache-2.0",
  "author": "OpenFig contributors",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./wrappers": "./src/wrappers/index.ts",
    "./wrappers/*": "./src/wrappers/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "codegen": "node codegen/generate-requests.ts && oxfmt src/requests.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "catalog:",
    "@fig/proto": "workspace:^",
    "@fig/shared": "workspace:^",
    "loglevel": "^1.9.2"
  },
  "devDependencies": {
    "@fig/config": "workspace:^",
    "@fig/spec-types": "workspace:^",
    "@types/node": "catalog:",
    "ts-morph": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=26"
  }
}
