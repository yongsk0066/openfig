{
  "name": "@fig/autocomplete-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "set-host": "q settings developer.autocomplete.host http://localhost:3124",
    "remove-host": "q settings developer.autocomplete.host --delete",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "vite preview --port 3124",
    "test": "vitest",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "catalog:",
    "@fig/api-bindings": "workspace:~",
    "@fig/autocomplete-parser": "workspace:^",
    "@fig/proto": "workspace:^",
    "@fig/shell-parser": "workspace:^",
    "@fig/spec-helpers": "workspace:^",
    "deep-object-diff": "^1.1.9",
    "loglevel": "^1.9.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-window": "^2.3.1",
    "tailwind-merge": "^3.6.0",
    "use-resize-observer": "^10.0.0",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@fig/config": "workspace:^",
    "@fig/fuzzysort": "workspace:^",
    "@fig/shared": "workspace:^",
    "@fig/spec-types": "workspace:^",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
