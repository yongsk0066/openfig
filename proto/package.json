{
  "name": "@fig/proto",
  "version": "0.2.0",
  "license": "MIT OR Apache-2.0",
  "author": "OpenFig contributors",
  "files": [
    "src",
    "package.json"
  ],
  "type": "module",
  "exports": {
    "./*": "./src/*_pb.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "codegen": "rm -rf src && buf generate",
    "lint": "buf lint && (buf format --exit-code > /dev/null || (echo 'Run `buf format -w`' && exit 1))",
    "lint:fix": "buf format -w"
  },
  "dependencies": {
    "@bufbuild/protobuf": "catalog:"
  },
  "devDependencies": {
    "@bufbuild/buf": "catalog:",
    "@bufbuild/protoc-gen-es": "catalog:"
  },
  "engines": {
    "node": ">=26"
  }
}
