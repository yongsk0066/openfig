    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@fig/config": "workspace:^",
    "@fig/spec-compiler": "workspace:^",
    "@fig/spec-types": "workspace:^",
    "@types/semver": "^7.8.0",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=26"
  }
}
