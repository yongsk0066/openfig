{
  "extends": "@fig/config/base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM"],
    "moduleResolution": "bundler",
    "types": ["@fig/spec-types"],
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    /* noUnusedParameters stays off for the 1,480 upstream spec files: 31 of
       its 56 hits are leading parameters of positional generator callbacks
       that cannot be dropped while a later one is used. oxlint owns that
       case (`args: "after-used"` for specs/src); the 25 droppable ones are
       already gone. */
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "noEmit": true
  },
  "include": ["src"]
}
