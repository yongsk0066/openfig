{
  "extends": "@fig/config/base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM"],
    "moduleResolution": "bundler",
    "types": ["@fig/spec-types"],
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    /* Still off for the 1,480 upstream spec files (counts measured on top of
       strict): noUnusedLocals 23 (unused imports, dead option/generator
       declarations), noUnusedParameters 56 (mostly generator callbacks that
       ignore `tokens`). Both are lint concerns, handled by oxlint. */
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noEmit": true
  },
  "include": ["src"]
}
